---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { loadAllArticles, loadWorldArticles, getAllCategories, getCategoryColor, getCategoryLabel, getCategorySlug, getMetaDescription } from '../../utils/articles';
import { withBase } from '../../utils/url';

export function getStaticPaths() {
  const PAGE_SIZE = 15;
  const allArticles = [...loadAllArticles(), ...loadWorldArticles()];
  const categories = getAllCategories(allArticles);
  const paths: any[] = [];

  for (const cat of categories) {
    const catSlug = getCategorySlug(cat);
    const catArticles = allArticles.filter((a) => a.categories.includes(cat));
    const totalPages = Math.max(1, Math.ceil(catArticles.length / PAGE_SIZE));

    for (let page = 1; page <= totalPages; page++) {
      const start = (page - 1) * PAGE_SIZE;
      const recentSources = [...new Set(catArticles.slice(0, 10).map((a) => a.source))].slice(0, 3);
      paths.push({
        params: { slug: page === 1 ? catSlug : `${catSlug}/${page}` },
        props: {
          category: cat,
          catSlug,
          articles: catArticles.slice(start, start + PAGE_SIZE),
          currentPage: page,
          totalPages,
          totalArticles: catArticles.length,
          recentSources,
        },
      });
    }
  }

  return paths;
}

const { category, catSlug, articles, currentPage, totalPages, totalArticles, recentSources } = Astro.props;
const siteUrl = new URL(withBase('/'), Astro.site).toString().replace(/\/$/, '');
const categoryLabel = getCategoryLabel(category);

function pageUrl(page: number): string {
  return page === 1 ? withBase(`/categorie/${catSlug}`) : withBase(`/categorie/${catSlug}/${page}`);
}

const pages: (number | string)[] = [];
for (let i = 1; i <= totalPages; i++) {
  if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
    pages.push(i);
  } else if (pages[pages.length - 1] !== '...') {
    pages.push('...');
  }
}
---

<Layout title={currentPage > 1 ? `${categoryLabel} - 第 ${currentPage} 页` : `${categoryLabel}分类文章`} description={getMetaDescription(`${categoryLabel}分类下共 ${totalArticles} 篇文章——来源：${recentSources.join('、')}。`)}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": `${categoryLabel} - 大数据运维与开发实战站`,
    "description": `${categoryLabel}分类下共 ${totalArticles} 篇文章。`,
    "url": `${siteUrl}/categorie/${catSlug}/`,
    "numberOfItems": totalArticles,
    "inLanguage": "zh-CN",
    "isPartOf": { "@type": "WebSite", "name": "大数据运维与开发实战站", "url": siteUrl },
  })} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "首页", "item": `${siteUrl}/` },
      { "@type": "ListItem", "position": 2, "name": categoryLabel },
    ]
  })} />
  <div class="fade-in-up">
    <div class="mb-8">
      <!-- Breadcrumb -->
      <nav aria-label="面包屑" class="mb-3">
        <ol class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
          <li><a href={withBase('/')} class="hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors">首页</a></li>
          <li class="text-slate-300 dark:text-slate-600">/</li>
          <li><a href={withBase('/categories')} class="hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors">分类</a></li>
          <li class="text-slate-300 dark:text-slate-600">/</li>
          <li class="text-slate-500 dark:text-slate-400">{categoryLabel}</li>
        </ol>
      </nav>
      <a href={withBase('/categories')} class="text-xs text-slate-500 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors mb-3 inline-flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
        全部分类
      </a>
      <h1 class="text-2xl sm:text-3xl font-bold mb-2 flex items-center gap-3">
        <span class={`px-3 py-1 text-sm font-medium rounded-full border ${getCategoryColor(category)}`}>{categoryLabel}</span>
      </h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm">
        {totalArticles} 篇文章
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {articles.map((article: any) => (
        <ArticleCard article={article} />
      ))}
    </div>

    {articles.length === 0 && (
      <div class="text-center py-20 text-slate-500 dark:text-slate-400">
        <p class="text-lg font-medium">该分类下暂无文章</p>
      </div>
    )}

    {totalPages > 1 && (
      <nav aria-label="分页" class="flex items-center justify-center gap-1.5 mt-8">
        {currentPage > 1 && (
          <a href={pageUrl(currentPage - 1)} class="px-3 py-2 text-sm rounded-lg border border-slate-200/90 dark:border-slate-700/60 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-600 transition-all" aria-label="上一页">←</a>
        )}
        {pages.map((p) => (
          p === '...' ? (
            <span class="px-2 py-2 text-sm text-slate-400 dark:text-slate-500">…</span>
          ) : p === currentPage ? (
            <span class="px-3 py-2 text-sm rounded-lg bg-emerald-600/15 border border-emerald-600/45 dark:border-emerald-400/45 text-emerald-700 dark:text-emerald-400 font-medium" aria-current="page">{p}</span>
          ) : (
            <a href={pageUrl(p as number)} class="px-3 py-2 text-sm rounded-lg border border-slate-200/90 dark:border-slate-700/60 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-600 transition-all">{p}</a>
          )
        ))}
        {currentPage < totalPages && (
          <a href={pageUrl(currentPage + 1)} class="px-3 py-2 text-sm rounded-lg border border-slate-200/90 dark:border-slate-700/60 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-600 transition-all" aria-label="下一页">→</a>
        )}
      </nav>
    )}
  </div>
</Layout>
