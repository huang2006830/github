---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/url';
import {
  VIDEO_CATEGORIES,
  VIDEOS,
  getCategoryMeta,
  watchUrl,
} from '../data/videos';

const total = VIDEOS.length;
const directions = VIDEO_CATEGORIES.length - 1;
const recentCount = VIDEOS.filter((video) => video.year >= 2024).length;
const classicCount = total - recentCount;
const countFor = (id: string) =>
  id === 'all' ? total : VIDEOS.filter((video) => video.category === id).length;
---
<Layout
  title="教学视频：Linux / Docker / K8s / 大数据精选"
  description="精选 B 站 Linux 基础、Docker/K8s 容器技术与大数据入门教学视频，按学习方向筛选、卡片式浏览，点击直达 B 站观看。"
>
  <div class="fade-in-up mx-auto max-w-6xl">
    <!-- Hero -->
    <section class="relative mb-10 overflow-hidden rounded-2xl border border-slate-200/90 bg-gradient-to-br from-emerald-500/15 via-[var(--color-surface-1)] to-sky-500/10 p-6 sm:p-10 dark:border-slate-700/60">
      <div class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-emerald-600/10 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-28 left-1/3 h-72 w-72 rounded-full bg-sky-500/10 blur-3xl"></div>

      <div class="relative max-w-3xl">
        <div class="mb-5 flex flex-wrap items-center gap-2">
          <span class="rounded-full border border-emerald-600/30 bg-emerald-600/10 px-2.5 py-1 text-xs font-medium text-emerald-800 dark:border-emerald-400/30 dark:bg-emerald-400/10 dark:text-emerald-300">教学视频</span>
          <span class="rounded-full border border-slate-200/90 bg-white/60 px-2.5 py-1 text-xs font-medium text-slate-600 backdrop-blur-sm dark:border-slate-700/60 dark:bg-slate-800/50 dark:text-slate-300">{total} 个精选合集</span>
          <span class="rounded-full border border-amber-600/25 bg-amber-500/10 px-2.5 py-1 text-xs font-medium text-amber-800 dark:border-amber-400/25 dark:text-amber-300">B 站 · 免费</span>
        </div>

        <h1 class="mb-4 text-3xl font-bold leading-tight tracking-tight sm:text-4xl lg:text-5xl">
          看视频，把 Linux 与<br class="hidden sm:block" />
          大数据栈真正跑起来
        </h1>
        <p class="max-w-2xl text-sm leading-relaxed text-slate-500 sm:text-base dark:text-slate-400">
          按「Linux 基础 → Docker / K8s → 大数据基础」三条线整理了 B 站上口碑最好的几套课。
          既有千万播放的经典老课，也有 2024–2025 年的新版教程；点击卡片即可在新标签页打开 B 站观看。
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a href="#all-videos" class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-emerald-500">
            浏览全部视频
            <span aria-hidden="true">→</span>
          </a>
          <a href={withBase('/learning-path')} class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-slate-400 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-500">
            配合学习路线
          </a>
        </div>

        <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
          <div class="rounded-xl border border-slate-200/90 bg-white/55 p-3.5 backdrop-blur-sm dark:border-slate-700/80 dark:bg-slate-950/25">
            <p class="text-lg font-bold text-slate-900 sm:text-xl dark:text-slate-100">{total}</p>
            <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">个精选合集</p>
          </div>
          <div class="rounded-xl border border-slate-200/90 bg-white/55 p-3.5 backdrop-blur-sm dark:border-slate-700/80 dark:bg-slate-950/25">
            <p class="text-lg font-bold text-slate-900 sm:text-xl dark:text-slate-100">{directions}</p>
            <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">个学习方向</p>
          </div>
          <div class="rounded-xl border border-slate-200/90 bg-white/55 p-3.5 backdrop-blur-sm dark:border-slate-700/80 dark:bg-slate-950/25">
            <p class="text-lg font-bold text-slate-900 sm:text-xl dark:text-slate-100">{recentCount}</p>
            <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">部 2024 年后更新</p>
          </div>
          <div class="rounded-xl border border-slate-200/90 bg-white/55 p-3.5 backdrop-blur-sm dark:border-slate-700/80 dark:bg-slate-950/25">
            <p class="text-lg font-bold text-slate-900 sm:text-xl dark:text-slate-100">{classicCount}</p>
            <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">部经典老课</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 全部视频 -->
    <section id="all-videos" class="scroll-mt-24">
      <div class="mb-5">
        <p class="mb-1 font-mono text-xs text-emerald-700 dark:text-emerald-400">01 / VIDEO LIBRARY</p>
        <h2 class="text-xl font-bold sm:text-2xl">全部视频 · 按方向筛选</h2>
        <p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-slate-500 dark:text-slate-400">
          每张卡片都标注了难度、集数和时长。B 站对站外播放有防盗链限制，点击卡片会在新标签页打开 B 站观看；播放量统计于 2026 年 10 月，仅作参考。
        </p>
      </div>

      <div class="mb-5 flex flex-col gap-3 rounded-2xl border border-slate-200/80 bg-white/60 p-2.5 backdrop-blur-md sm:flex-row sm:items-center sm:justify-between dark:border-slate-700/50 dark:bg-slate-800/50">
        <div class="flex flex-wrap gap-1.5" role="group" aria-label="按学习方向筛选视频">
          {VIDEO_CATEGORIES.map((category) => (
            <button
              type="button"
              data-video-filter={category.id}
              aria-pressed={category.id === 'all' ? 'true' : 'false'}
              aria-controls="video-grid"
              class="cursor-pointer rounded-xl px-3.5 py-2 text-sm font-medium text-slate-600 transition-all duration-200 hover:bg-slate-200/60 hover:text-slate-900 aria-pressed:bg-emerald-600 aria-pressed:text-white aria-pressed:shadow-md aria-pressed:shadow-emerald-600/20 dark:text-slate-400 dark:hover:bg-slate-700/60 dark:hover:text-slate-100 dark:aria-pressed:bg-emerald-500 dark:aria-pressed:text-slate-950"
            >
              {category.label}
              <span class="ml-1 text-xs opacity-70">{countFor(category.id)}</span>
            </button>
          ))}
        </div>
        <p class="px-2 text-xs text-slate-500 dark:text-slate-400" aria-live="polite">
          显示 <span id="video-visible-count" class="font-semibold text-slate-700 dark:text-slate-200">{total}</span> / {total} 个合集
        </p>
      </div>

      <div id="video-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {VIDEOS.map((video) => {
          const meta = getCategoryMeta(video.category);
          return (
            <a
              href={watchUrl(video.id)}
              target="_blank"
              rel="noopener noreferrer"
              data-video-card
              data-category={video.category}
              class="video-card group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200/80 bg-white/60 shadow-sm shadow-slate-900/5 backdrop-blur-md transition-all duration-300 hover:-translate-y-1.5 hover:border-emerald-400/60 hover:shadow-xl hover:shadow-emerald-500/15 dark:border-slate-700/50 dark:bg-slate-800/50 dark:shadow-black/20 dark:hover:border-emerald-400/40 dark:hover:shadow-emerald-500/20"
            >
              <!-- 封面 -->
              <div class="relative aspect-[16/9] overflow-hidden bg-slate-100 dark:bg-slate-900/40">
                <img
                  src={video.cover}
                  alt={`${video.title} 封面`}
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.06]"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
                />
                <div class={`ph-surface ${meta.placeholder} absolute inset-0 hidden items-center justify-center p-6`}>
                  <span class="relative z-10 line-clamp-3 text-center text-sm font-semibold leading-relaxed text-slate-800/70 dark:text-slate-100/70">
                    {video.title}
                  </span>
                </div>

                <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/55 via-slate-950/0 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

                <span class={`absolute left-3 top-3 rounded-full border px-2.5 py-0.5 text-[11px] font-semibold backdrop-blur-md ${meta.chip}`}>
                  {meta.label}
                </span>
                <span class="absolute bottom-3 right-3 rounded-md bg-slate-950/75 px-2 py-0.5 text-[11px] font-medium text-white backdrop-blur-sm">
                  {video.duration}
                </span>
                <span class="absolute left-1/2 top-1/2 flex h-12 w-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-white/30 bg-white/20 text-white opacity-0 backdrop-blur-md transition-all duration-300 group-hover:scale-110 group-hover:opacity-100">
                  <svg class="ml-0.5 h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86A1 1 0 0 0 8 5.14Z" />
                  </svg>
                </span>
              </div>

              <!-- 内容 -->
              <div class="flex flex-1 flex-col gap-3 p-5">
                <div class="flex flex-wrap items-center gap-2 text-[11px] text-slate-500 dark:text-slate-400">
                  <span class="rounded-full border border-slate-200/90 bg-slate-50/70 px-2 py-0.5 dark:border-slate-700/60 dark:bg-slate-900/30">{video.level}</span>
                  <span>{video.year}</span>
                  <span class="text-slate-300 dark:text-slate-600">·</span>
                  <span>{video.parts > 1 ? `${video.parts} 集` : '单集'}</span>
                </div>

                <h3 class="line-clamp-2 text-base font-bold leading-snug tracking-tight text-slate-900 transition-colors duration-200 group-hover:text-emerald-700 sm:text-lg dark:text-slate-100 dark:group-hover:text-emerald-300">
                  {video.title}
                </h3>

                <p class="line-clamp-2 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
                  {video.blurb}
                </p>

                <div class="flex flex-wrap gap-1.5">
                  {video.tags.map((tag) => (
                    <span class="rounded-md border border-slate-200/90 bg-slate-100/60 px-2 py-0.5 text-[11px] text-slate-500 dark:border-slate-700/60 dark:bg-slate-900/30 dark:text-slate-400">
                      {tag}
                    </span>
                  ))}
                </div>

                <div class="mt-auto flex items-center justify-between gap-3 border-t border-slate-200/70 pt-3 dark:border-slate-700/50">
                  <div class="flex min-w-0 items-center gap-2">
                    <span class="relative flex h-6 w-6 shrink-0 items-center justify-center overflow-hidden rounded-full bg-emerald-600/15 text-[10px] font-bold text-emerald-800 dark:bg-emerald-400/15 dark:text-emerald-300">
                      {video.up.slice(0, 1)}
                      <img
                        src={video.upFace}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                        class="absolute inset-0 h-full w-full object-cover"
                        onerror="this.remove();"
                      />
                    </span>
                    <span class="truncate text-xs font-medium text-slate-600 dark:text-slate-300">{video.up}</span>
                  </div>
                  <span class="flex shrink-0 items-center gap-1 text-xs text-slate-500 dark:text-slate-400">
                    {video.play} 播放
                    <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- 学习建议 -->
    <section class="mt-12 rounded-2xl border border-emerald-600/20 bg-gradient-to-br from-emerald-500/10 to-teal-500/5 p-6 sm:p-8 dark:border-emerald-400/20">
      <h2 class="mb-2 text-lg font-bold sm:text-xl">看视频的三个建议</h2>
      <p class="mb-6 max-w-2xl text-sm leading-relaxed text-slate-500 dark:text-slate-400">
        视频只是输入，真正的掌握来自「暂停 → 动手 → 复述」。下面三步能让你少走很多弯路。
      </p>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div class="rounded-xl border border-slate-200/90 bg-white/55 p-4 backdrop-blur-sm dark:border-slate-700/70 dark:bg-slate-950/25">
          <p class="mb-1 font-mono text-[11px] text-emerald-700 dark:text-emerald-400">STEP 01</p>
          <h3 class="mb-1.5 text-sm font-semibold text-slate-800 dark:text-slate-200">先 1.25 倍速过一遍</h3>
          <p class="text-sm leading-relaxed text-slate-500 dark:text-slate-400">不要暂停，先建立这套课在讲什么的全局地图，再决定哪几集需要精看。</p>
        </div>
        <div class="rounded-xl border border-slate-200/90 bg-white/55 p-4 backdrop-blur-sm dark:border-slate-700/70 dark:bg-slate-950/25">
          <p class="mb-1 font-mono text-[11px] text-emerald-700 dark:text-emerald-400">STEP 02</p>
          <h3 class="mb-1.5 text-sm font-semibold text-slate-800 dark:text-slate-200">每集动手敲一遍</h3>
          <p class="text-sm leading-relaxed text-slate-500 dark:text-slate-400">Linux 命令、Docker 命令、Spark 代码都要在自己的终端里跑通，报错才是最好的笔记。</p>
        </div>
        <div class="rounded-xl border border-slate-200/90 bg-white/55 p-4 backdrop-blur-sm dark:border-slate-700/70 dark:bg-slate-950/25">
          <p class="mb-1 font-mono text-[11px] text-emerald-700 dark:text-emerald-400">STEP 03</p>
          <h3 class="mb-1.5 text-sm font-semibold text-slate-800 dark:text-slate-200">用自己的话复述</h3>
          <p class="text-sm leading-relaxed text-slate-500 dark:text-slate-400">看完一节，合上视频写三句话总结；写不出来，就说明还没真正理解。</p>
        </div>
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={withBase('/learning-path')} class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-emerald-500">
          配合学习路线使用
          <span aria-hidden="true">→</span>
        </a>
        <a href={withBase('/cheatsheet')} class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-slate-400 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-500">
          打开速查手册
        </a>
        <a href={withBase('/resources')} class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-slate-400 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-500">
          更多学习资料
        </a>
      </div>
    </section>

    <p class="mt-8 text-xs leading-relaxed text-slate-400 dark:text-slate-500">
      视频版权归各 UP 主及 B 站所有，本站仅做学习导航，点击卡片会跳转至 B 站观看。若视频下架或链接失效，可在站点仓库提 Issue。
    </p>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      const buttons = Array.from(document.querySelectorAll('[data-video-filter]'));
      const cards = Array.from(document.querySelectorAll('[data-video-card]'));
      const counter = document.getElementById('video-visible-count');
      if (!buttons.length || !cards.length) return;

      const applyFilter = (filter: string) => {
        let visible = 0;
        cards.forEach((card) => {
          const show = filter === 'all' || card.dataset.category === filter;
          card.style.display = show ? '' : 'none';
          if (show) visible += 1;
        });
        buttons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.videoFilter === filter));
        });
        if (counter) counter.textContent = String(visible);
      };

      buttons.forEach((button) => {
        button.onclick = () => applyFilter(button.dataset.videoFilter ?? 'all');
      });
    });
  </script>
</Layout>
