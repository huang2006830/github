---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/url';
---

<Layout title="页面已停用" description="该页面已停用。" noindex>
  <div class="fade-in-up max-w-xl mx-auto text-center py-20">
    <h1 class="text-2xl font-bold mb-4">页面已停用</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-8">
      这个工具不再维护。请返回首页浏览聚合文章。
    </p>
    <a href={withBase('/')} class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold transition-colors">
      返回首页
    </a>
  </div>
</Layout>
