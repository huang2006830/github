---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { loadAllArticles, loadWorldArticles, getAllSources, getCategoryColor, getCategoryLabel, getMetaDescription } from '../../utils/articles';
import { withBase } from '../../utils/url';

export function getStaticPaths() {
  const PAGE_SIZE = 15;
  const allArticles = [...loadAllArticles(), ...loadWorldArticles()];
  const sources = getAllSources(allArticles);
  const paths: any[] = [];

  for (const source of sources) {
    const sourceArticles = allArticles.filter((a) => a.source === source.name);
    const totalPages = Math.max(1, Math.ceil(sourceArticles.length / PAGE_SIZE));

    for (let page = 1; page <= totalPages; page++) {
      const start = (page - 1) * PAGE_SIZE;
      const recentTopics = [...new Set(sourceArticles.slice(0, 10).flatMap((a) => a.categories))].slice(0, 3);
      paths.push({
        params: { slug: page === 1 ? source.slug : `${source.slug}/${page}` },
        props: {
          source,
          articles: sourceArticles.slice(start, start + PAGE_SIZE),
          currentPage: page,
          totalPages,
          totalArticles: sourceArticles.length,
          recentTopics,
        },
      });
    }
  }

  return paths;
}

const { source, articles, currentPage, totalPages, totalArticles, recentTopics } = Astro.props;
const siteUrl = new URL(withBase('/'), Astro.site).toString().replace(/\/$/, '');

function pageUrl(page: number): string {
  return page === 1 ? withBase(`/source/${source.slug}`) : withBase(`/source/${source.slug}/${page}`);
}

const pages: (number | string)[] = [];
for (let i = 1; i <= totalPages; i++) {
  if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
    pages.push(i);
  } else if (pages[pages.length - 1] !== '...') {
    pages.push('...');
  }
}
---

<Layout title={currentPage > 1 ? `${source.name} - 第 ${currentPage} 页` : source.name} description={getMetaDescription(`来自 ${source.name} 的 ${totalArticles} 篇文章——主题：${recentTopics.join('、')}。`)}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": `${source.name} - 大数据运维与开发实战站`,
    "description": `来自 ${source.name} 的 ${totalArticles} 篇文章。`,
    "url": `${siteUrl}/source/${source.slug}/`,
    "numberOfItems": totalArticles,
    "inLanguage": "zh-CN",
    "isPartOf": { "@type": "WebSite", "name": "大数据运维与开发实战站", "url": siteUrl },
  })} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "首页", "item": `${siteUrl}/` },
      { "@type": "ListItem", "position": 2, "name": "来源", "item": `${siteUrl}/sources/` },
      { "@type": "ListItem", "position": 3, "name": source.name },
    ]
  })} />
  <div class="fade-in-up">
    <div class="mb-8">
      <!-- Breadcrumb -->
      <nav aria-label="面包屑" class="mb-3">
        <ol class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
          <li><a href={withBase('/')} class="hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors">首页</a></li>
          <li class="text-slate-300 dark:text-slate-600">/</li>
          <li><a href={withBase('/sources')} class="hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors">来源</a></li>
          <li class="text-slate-300 dark:text-slate-600">/</li>
          <li class="text-slate-500 dark:text-slate-400">{source.name}</li>
        </ol>
      </nav>
      <a href={withBase('/sources')} class="text-xs text-slate-500 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors mb-3 inline-flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
        全部来源
      </a>
      <h1 class="text-2xl sm:text-3xl font-bold mb-2">{source.name}</h1>
      <div class="flex items-center gap-3 mb-3">
        <span class="text-slate-500 dark:text-slate-400 text-sm">{totalArticles} 篇文章</span>
        <a
          href={source.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-slate-500 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors inline-flex items-center gap-1"
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
          RSS 订阅
        </a>
      </div>
      <div class="flex flex-wrap gap-1.5">
        {source.categories.map((cat: string) => (
          <span class={`px-2 py-0.5 text-xs font-medium rounded-full border ${getCategoryColor(cat)}`}>
            {getCategoryLabel(cat)}
          </span>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {articles.map((article: any) => (
        <ArticleCard article={article} />
      ))}
    </div>

    {articles.length === 0 && (
      <div class="text-center py-20 text-slate-500 dark:text-slate-400">
        <p class="text-lg font-medium">该来源下暂无文章</p>
      </div>
    )}

    {totalPages > 1 && (
      <nav aria-label="分页" class="flex items-center justify-center gap-1.5 mt-8">
        {currentPage > 1 && (
          <a href={pageUrl(currentPage - 1)} class="px-3 py-2 text-sm rounded-lg border border-slate-200/90 dark:border-slate-700/60 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-600 transition-all" aria-label="上一页">←</a>
        )}
        {pages.map((p) => (
          p === '...' ? (
            <span class="px-2 py-2 text-sm text-slate-400 dark:text-slate-500">…</span>
          ) : p === currentPage ? (
            <span class="px-3 py-2 text-sm rounded-lg bg-emerald-600/15 border border-emerald-600/45 dark:border-emerald-400/45 text-emerald-700 dark:text-emerald-400 font-medium" aria-current="page">{p}</span>
          ) : (
            <a href={pageUrl(p as number)} class="px-3 py-2 text-sm rounded-lg border border-slate-200/90 dark:border-slate-700/60 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-600 transition-all">{p}</a>
          )
        ))}
        {currentPage < totalPages && (
          <a href={pageUrl(currentPage + 1)} class="px-3 py-2 text-sm rounded-lg border border-slate-200/90 dark:border-slate-700/60 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-600 transition-all" aria-label="下一页">→</a>
        )}
      </nav>
    )}
  </div>
</Layout>
