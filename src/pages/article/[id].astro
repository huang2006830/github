---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { loadAllArticles, loadWorldArticles, getRelatedArticles, formatDate, getCategoryColor, getPlaceholderClass, getCategoryLabel, getFreshnessBadge, getTypeLabel, getTypeColor, slugify, getCategorySlug, getMetaDescription } from '../../utils/articles';
import { withBase } from '../../utils/url';

export function getStaticPaths() {
  const frArticles = loadAllArticles();
  const worldArticles = loadWorldArticles();
  const allArticles = [...frArticles, ...worldArticles];
  return allArticles.map((article) => ({
    params: { id: article.id },
    props: { article, allArticles },
  }));
}

const { article, allArticles } = Astro.props;
const related = getRelatedArticles(article, allArticles);
const badge = getFreshnessBadge(article.pubDate);
const placeholder = getPlaceholderClass(article.id || article.link);
const siteUrl = new URL(withBase('/'), Astro.site).toString().replace(/\/$/, '');
---

<Layout title={`${article.title} (${article.source})`} description={getMetaDescription(article.description)} image={article.image || undefined} canonicalOverride={article.link}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(
    article.type === 'youtube' ? {
      "@context": "https://schema.org",
      "@type": "VideoObject",
      "name": article.title,
      "description": article.description,
      "uploadDate": article.pubDate,
      "contentUrl": article.link,
      ...(article.videoId ? { "embedUrl": `https://www.youtube.com/embed/${article.videoId}` } : {}),
      ...(article.image ? { "thumbnailUrl": article.image } : {}),
      "publisher": { "@type": "Organization", "name": article.source, "url": article.sourceUrl },
    } : article.type === 'podcast' ? {
      "@context": "https://schema.org",
      "@type": "PodcastEpisode",
      "name": article.title,
      "description": article.description,
      "datePublished": article.pubDate,
      "url": article.link,
      "partOfSeries": { "@type": "PodcastSeries", "name": article.source, "url": article.sourceUrl },
      ...(article.audioUrl ? { "associatedMedia": { "@type": "AudioObject", "contentUrl": article.audioUrl } } : {}),
      ...(article.duration ? { "timeRequired": article.duration } : {}),
    } : {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": article.title,
      "description": article.description,
      "datePublished": article.pubDate,
      "author": { "@type": "Organization", "name": article.source, "url": article.sourceUrl },
      "publisher": { "@type": "Organization", "name": "大数据运维与开发实战站", "url": siteUrl },
      ...(article.image ? { "image": article.image } : {}),
      "mainEntityOfPage": article.link,
      "inLanguage": "zh-CN",
    }
  )} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "首页", "item": `${siteUrl}/` },
      { "@type": "ListItem", "position": 2, "name": article.source, "item": `${siteUrl}/source/${slugify(article.source)}/` },
      { "@type": "ListItem", "position": 3, "name": article.title },
    ]
  })} />
  <article class="fade-in-up mx-auto max-w-3xl">
    <!-- 面包屑 -->
    <nav aria-label="面包屑" class="mb-4">
      <ol class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
        <li><a href={withBase('/')} class="transition-colors hover:text-emerald-700 dark:hover:text-emerald-300">首页</a></li>
        <li class="text-slate-300 dark:text-slate-600">/</li>
        <li><a href={withBase(`/source/${slugify(article.source)}`)} class="transition-colors hover:text-emerald-700 dark:hover:text-emerald-300">{article.source}</a></li>
        <li class="text-slate-300 dark:text-slate-600">/</li>
        <li class="max-w-[200px] truncate text-slate-500 dark:text-slate-400">{article.title}</li>
      </ol>
    </nav>

    <!-- 封面 -->
    <div class="relative mb-6 aspect-[2/1] overflow-hidden rounded-2xl border border-slate-200/70 bg-slate-100 dark:border-slate-700/50 dark:bg-slate-900/40">
      {article.image ? (
        <>
          <img
            src={article.image}
            alt={article.title}
            loading="eager"
            class="h-full w-full object-cover"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
          />
          <div class={`ph-surface ${placeholder} relative hidden h-full w-full items-center justify-center p-8`}>
            <span class="relative z-10 line-clamp-3 text-center text-xl font-medium leading-relaxed text-slate-800/70 dark:text-slate-100/60">{article.title}</span>
          </div>
        </>
      ) : (
        <div class={`ph-surface ${placeholder} relative flex h-full w-full items-center justify-center p-8`}>
          <span class="relative z-10 line-clamp-3 text-center text-xl font-medium leading-relaxed text-slate-800/70 dark:text-slate-100/60">{article.title}</span>
        </div>
      )}
    </div>

    <!-- 元信息 -->
    <div class="mb-4 flex flex-wrap items-center gap-2">
      {article.categories.map((cat) => (
        <a href={withBase(`/categorie/${getCategorySlug(cat)}`)} class={`rounded-full border px-2.5 py-1 text-xs font-medium transition-opacity hover:opacity-70 ${getCategoryColor(cat)}`}>
          {getCategoryLabel(cat)}
        </a>
      ))}
      {badge && (
        <span class={`rounded-full px-2.5 py-1 text-xs font-semibold ${badge.class}`}>
          {badge.label}
        </span>
      )}
      {(article.type === 'podcast' || article.type === 'youtube') && (
        <span class={`rounded-full border px-2.5 py-1 text-xs font-medium ${getTypeColor(article.type)}`}>
          {getTypeLabel(article.type)}
        </span>
      )}
    </div>

    <!-- 标题 -->
    <h1 class="mb-4 text-2xl font-bold leading-tight tracking-tight text-slate-900 sm:text-3xl dark:text-slate-100">{article.title}</h1>

    <!-- 来源与日期 -->
    <div class="mb-6 flex flex-wrap items-center gap-3 border-b border-slate-200/80 pb-6 text-sm text-slate-500 dark:border-slate-700/50 dark:text-slate-400">
      <a href={withBase(`/source/${slugify(article.source)}`)} class="inline-flex items-center gap-1.5 transition-colors hover:text-emerald-700 dark:hover:text-emerald-300">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z" />
        </svg>
        {article.source}
      </a>
      <span class="text-slate-300 dark:text-slate-600">·</span>
      <time datetime={article.pubDate}>{formatDate(article.pubDate)}</time>
    </div>

    <!-- 摘要 -->
    <div class="mb-8 max-w-none text-base leading-relaxed text-slate-600 dark:text-slate-300">
      <p>{article.description}</p>
    </div>

    <!-- 音频播放器（播客） -->
    {article.audioUrl && (
      <div class="mb-8 rounded-2xl border border-fuchsia-500/25 bg-fuchsia-500/5 p-4 dark:border-fuchsia-400/20 dark:bg-fuchsia-400/5">
        <div class="mb-3 flex items-center gap-2">
          <svg class="h-4 w-4 text-fuchsia-600 dark:text-fuchsia-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z" />
          </svg>
          <span class="text-sm font-medium text-fuchsia-800 dark:text-fuchsia-300">收听本集</span>
          {article.duration && (
            <span class="ml-auto text-xs text-slate-500 dark:text-slate-400">{article.duration}</span>
          )}
        </div>
        <audio controls preload="none" class="h-10 w-full" data-fallback-link={article.link}>
          <source src={article.audioUrl} type="audio/mpeg" />
        </audio>
        <a href={article.link} target="_blank" rel="noopener noreferrer" class="audio-fallback mt-3 hidden items-center gap-1.5 text-sm text-fuchsia-600 transition-colors hover:text-fuchsia-700 dark:text-fuchsia-400 dark:hover:text-fuchsia-300">
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
          在原始网站收听
        </a>
      </div>
    )}

    <!-- YouTube 嵌入 -->
    {article.videoId && (
      <div class="mb-8 overflow-hidden rounded-2xl border border-rose-500/25 dark:border-rose-400/20">
        <div class="relative w-full" style="padding-bottom: 56.25%;">
          <iframe
            src={`https://www.youtube.com/embed/${article.videoId}`}
            title={article.title}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            class="absolute inset-0 h-full w-full"
            loading="lazy"
          ></iframe>
        </div>
      </div>
    )}

    <!-- CTA -->
    <div class="rounded-2xl border border-emerald-600/20 bg-emerald-500/5 p-6 text-center dark:border-emerald-400/20 dark:bg-emerald-400/5">
      <p class="mb-3 text-sm text-slate-600 dark:text-slate-300">如果这篇文章对你有帮助，欢迎访问 <strong class="text-emerald-800 dark:text-emerald-300">{article.source}</strong> 支持原作者</p>
      <a
        href={article.link}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-emerald-600/25 transition-all duration-300 hover:-translate-y-0.5 hover:bg-emerald-700 hover:shadow-xl hover:shadow-emerald-600/30 dark:bg-emerald-500 dark:text-emerald-950 dark:shadow-emerald-500/20 dark:hover:bg-emerald-400"
      >
        {article.type === 'youtube' ? "在 YouTube 观看" : article.type === 'podcast' ? "查看原节目" : "阅读原文"}
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </article>

  <!-- 相关文章 -->
  {related.length > 0 && (
    <section class="mt-16">
      <h2 class="mb-6 text-lg font-bold tracking-tight text-slate-900 dark:text-slate-100">相关文章</h2>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {related.map((a) => (
          <ArticleCard article={a} />
        ))}
      </div>
    </section>
  )}
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    // Mark as read
    const path = window.location.pathname;
    const id = path.split('/').filter(Boolean).pop();
    if (id) {
      localStorage.setItem(`flux-read-${id}`, 'true');
    }

    // Audio player fallback: show link if audio fails to load
    const audio = document.querySelector('audio[data-fallback-link]') as HTMLAudioElement | null;
    if (audio) {
      const fallback = audio.parentElement?.querySelector('.audio-fallback') as HTMLElement | null;
      audio.addEventListener('error', () => {
        audio.style.display = 'none';
        if (fallback) fallback.classList.remove('hidden');
        if (fallback) fallback.classList.add('flex');
      });
      // Also handle source-level errors
      const source = audio.querySelector('source');
      source?.addEventListener('error', () => {
        audio.style.display = 'none';
        if (fallback) fallback.classList.remove('hidden');
        if (fallback) fallback.classList.add('flex');
      });
    }
  });
</script>
