---
import Layout from '../layouts/Layout.astro';
import {
  loadAllArticles,
  loadWorldArticles,
  getAllCategories,
  getCategoryColor,
  getPlaceholderClass,
  getCategoryLabel,
  getCategorySlug,
} from '../utils/articles';
import { withBase } from '../utils/url';

const allArticles = [...loadAllArticles(), ...loadWorldArticles()];
const categories = getAllCategories(allArticles);

const categoryStats = categories
  .map((cat) => {
    const articles = allArticles.filter((a) => a.categories.includes(cat));
    const sources = new Set(articles.map((a) => a.source));
    return {
      name: cat,
      label: getCategoryLabel(cat),
      slug: getCategorySlug(cat),
      count: articles.length,
      sourceCount: sources.size,
      placeholder: getPlaceholderClass(cat),
    };
  })
  .sort((a, b) => b.count - a.count);
---

<Layout title="分类" description={`${categories.length} 个大数据技术分类——共 ${allArticles.length} 篇文章。`}>
  <div class="fade-in-up">
    <div class="mb-8">
      <h1 class="mb-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-slate-100">分类</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">
        {categories.length} 个分类 — 共 {allArticles.length} 篇文章
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {categoryStats.map((cat) => (
        <a
          href={withBase(`/categorie/${cat.slug}`)}
          class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200/80 bg-white/60 shadow-sm shadow-slate-900/5 backdrop-blur-md transition-all duration-300 hover:-translate-y-1.5 hover:border-sky-400/60 hover:shadow-lg hover:shadow-sky-500/20 dark:border-slate-700/50 dark:bg-slate-800/50 dark:shadow-black/20 dark:hover:border-sky-400/40"
        >
          <div class={`ph-surface ${cat.placeholder} relative h-1.5`}></div>
          <div class="flex flex-1 flex-col gap-3 p-5">
            <div class="flex items-start justify-between gap-3">
              <h3 class="flex items-center gap-2 text-base font-bold tracking-tight text-slate-900 dark:text-slate-100">
                <span class={`rounded-full border px-2.5 py-0.5 text-xs font-medium ${getCategoryColor(cat.name)}`}>
                  {cat.label}
                </span>
              </h3>
              <span class="shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500 dark:bg-slate-700/40 dark:text-slate-400">
                {cat.count} 篇
              </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">{cat.sourceCount} 个来源</p>
            <span class="mt-auto inline-flex items-center gap-1 text-xs font-medium text-emerald-700 transition-colors group-hover:text-emerald-800 dark:text-emerald-300 dark:group-hover:text-emerald-200">
              查看全部文章
              <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
