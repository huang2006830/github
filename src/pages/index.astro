---
import Layout from '../layouts/Layout.astro';
import ArticleListPage from '../components/ArticleListPage.astro';
import { loadAllArticles, getSiteCategories, getAllSources, getAllTypes } from '../utils/articles';
import { SITE_NAME, SITE_DESCRIPTION } from '../config/site';

const PAGE_SIZE = 15;
const allArticles = loadAllArticles();
const categories = getSiteCategories(allArticles);
const sources = getAllSources(allArticles);
const types = getAllTypes(allArticles);
const totalPages = Math.max(1, Math.ceil(allArticles.length / PAGE_SIZE));
const articles = allArticles.slice(0, PAGE_SIZE);
---

<Layout title={SITE_NAME} description={`${SITE_DESCRIPTION}——当前收录 ${allArticles.length} 篇文章，来自 ${sources.length} 个 RSS 来源。`}>
  <ArticleListPage
    articles={articles}
    categories={categories}
    sources={sources}
    types={types}
    currentPage={1}
    totalPages={totalPages}
  />
</Layout>
