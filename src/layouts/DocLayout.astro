---
import Layout from './Layout.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    updated?: string | Date;
    tags?: string[];
    editHint?: boolean;
  };
}

const { frontmatter } = Astro.props;
const { title, description, editHint = true, tags = [] } = frontmatter;

// YAML 里的 2026-10-26 会被解析成 Date，这里统一按 YYYY-MM-DD 展示
const updatedDate = frontmatter.updated ? new Date(frontmatter.updated) : null;
const updatedLabel =
  updatedDate && !Number.isNaN(updatedDate.getTime())
    ? updatedDate.toISOString().slice(0, 10)
    : undefined;
---

<Layout title={title} description={description}>
  <article class="fade-in-up max-w-4xl mx-auto">
    <header class="mb-8 border-b border-slate-200/80 pb-6 dark:border-slate-700/50">
      {tags.length > 0 && (
        <div class="mb-4 flex flex-wrap items-center gap-2">
          {tags.map((tag) => (
            <span class="rounded-full border border-emerald-700/25 bg-emerald-600/10 px-2.5 py-1 text-xs font-medium text-emerald-800 dark:border-emerald-400/25 dark:bg-emerald-400/10 dark:text-emerald-300">{tag}</span>
          ))}
        </div>
      )}
      <h1 class="mb-3 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-slate-100">{title}</h1>
      {description && <p class="text-sm leading-relaxed text-slate-500 dark:text-slate-400">{description}</p>}
      {updatedLabel && <p class="mt-3 text-xs text-slate-400 dark:text-slate-500">最近更新：{updatedLabel}</p>}
    </header>

    <div class="doc-content">
      <slot />
    </div>

    {editHint && (
      <p class="mt-12 border-t border-slate-200/80 pt-6 text-xs leading-relaxed text-slate-400 dark:border-slate-700/50 dark:text-slate-500">
        维护提示：本页内容为手工维护的 Markdown，可在仓库对应文件中直接编辑，新增条目请保持同级列表格式。
      </p>
    )}
  </article>
</Layout>
