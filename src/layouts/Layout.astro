---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import BackToTop from '../components/BackToTop.astro';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalOverride?: string;
  noindex?: boolean;
}

const { title, description = '大数据技术学习站 — 每日自动聚合大数据技术文章、行业动态与学习资源。', image, canonicalOverride, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rawPath = Astro.url.pathname.startsWith(base) ? Astro.url.pathname : `${base}${Astro.url.pathname}`;
const pathname = rawPath === base ? `${base}/` : rawPath;
const canonicalURL = canonicalOverride || new URL(pathname, Astro.site).toString();
const siteUrl = new URL(withBase('/'), Astro.site).toString().replace(/\/$/, '');
const defaultImage = new URL(withBase('/og.webp'), Astro.site).toString();
const ogImage = image || defaultImage;
const isHome = title === '大数据技术学习站';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{isHome ? title : `${title} | 大数据技术学习站`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="zh-CN" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={isHome ? title : `${title} | 大数据技术学习站`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="大数据技术学习站" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={isHome ? title : `${title} | 大数据技术学习站`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="大数据技术学习站 RSS" href={withBase('/rss.xml')} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" /></noscript>

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "大数据技术学习站",
      "url": siteUrl,
      "description": "每日自动聚合大数据技术文章、行业动态与学习资源，面向大数据技术专业学生。",
      "inLanguage": "zh-CN",
      "publisher": {
        "@type": "Organization",
        "name": "大数据技术学习站"
      }
    })} />
    <slot name="head" />

    <ClientRouter fallback="swap" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>
    <footer class="border-t border-zinc-800/60 py-8 text-sm text-zinc-500">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-6">
          <div>
            <h4 class="text-xs uppercase tracking-widest text-zinc-600 font-medium mb-3">热门分类</h4>
            <nav class="flex flex-col gap-1.5">
              <a href={withBase('/categorie/big-data')} class="text-zinc-500 hover:text-indigo-400 transition-colors">大数据</a>
              <a href={withBase('/categorie/data-science')} class="text-zinc-500 hover:text-indigo-400 transition-colors">数据科学</a>
              <a href={withBase('/categorie/data-engineering')} class="text-zinc-500 hover:text-indigo-400 transition-colors">数据工程</a>
              <a href={withBase('/categorie/programmation')} class="text-zinc-500 hover:text-indigo-400 transition-colors">编程</a>
            </nav>
          </div>
          <div>
            <h4 class="text-xs uppercase tracking-widest text-zinc-600 font-medium mb-3">站点导航</h4>
            <nav class="flex flex-col gap-1.5">
              <a href={withBase('/')} class="text-zinc-500 hover:text-indigo-400 transition-colors">文章</a>
              <a href={withBase('/learning-path')} class="text-zinc-500 hover:text-indigo-400 transition-colors">学习路线</a>
              <a href={withBase('/sources')} class="text-zinc-500 hover:text-indigo-400 transition-colors">来源</a>
              <a href={withBase('/categories')} class="text-zinc-500 hover:text-indigo-400 transition-colors">分类</a>
              <a href={withBase('/stats')} class="text-zinc-500 hover:text-indigo-400 transition-colors">统计</a>
            </nav>
          </div>
          <div>
            <h4 class="text-xs uppercase tracking-widest text-zinc-600 font-medium mb-3">本站</h4>
            <nav class="flex flex-col gap-1.5">
              <a href={withBase('/rss.xml')} class="text-zinc-500 hover:text-indigo-400 transition-colors inline-flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/></svg>
                RSS 订阅
              </a>
              <a href={withBase('/newsletter')} class="text-zinc-500 hover:text-indigo-400 transition-colors">订阅说明</a>
              <a href={withBase('/confidentialite')} class="text-zinc-500 hover:text-indigo-400 transition-colors">隐私说明</a>
            </nav>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-6 border-t border-zinc-800/40">
          <p>大数据技术学习站 — 每日自动聚合大数据学习资源</p>
          <span class="text-zinc-600">基于 Astro 构建 · 静态托管</span>
        </div>
      </div>
    </footer>
    <BackToTop />
  </body>
</html>
