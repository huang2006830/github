---
import ArticleCard from './ArticleCard.astro';
import SearchBar from './SearchBar.astro';
import CategoryFilter from './CategoryFilter.astro';
import type { Article, FeedType } from '../types/index';
import { withBase } from '../utils/url';

interface Props {
  articles: Article[];
  categories: string[];
  sources: { name: string; slug: string; url: string; categories: string[]; count: number }[];
  types: FeedType[];
  currentPage: number;
  totalPages: number;
  basePath?: string;
}

const { articles, categories, sources, types, currentPage, totalPages, basePath = '' } = Astro.props;

function pageUrl(page: number): string {
  if (basePath) {
    return page === 1 ? withBase(`/${basePath}`) : withBase(`/${basePath}/page/${page}`);
  }
  return page === 1 ? withBase('/') : withBase(`/page/${page}`);
}

const searchIndexUrl = withBase(basePath ? `/${basePath}/search-index.json` : '/search-index.json');

const pages: (number | string)[] = [];
for (let i = 1; i <= totalPages; i++) {
  if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
    pages.push(i);
  } else if (pages[pages.length - 1] !== '...') {
    pages.push('...');
  }
}

const pageLinkClass =
  'rounded-xl border border-slate-200/90 px-3 py-2 text-sm text-slate-600 transition-all duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:text-slate-900 dark:border-slate-700/60 dark:text-slate-400 dark:hover:border-slate-600 dark:hover:text-slate-200';
---

<div class="flex flex-col gap-6">
  <!-- 搜索 + 筛选 -->
  <div class="flex flex-col gap-3 rounded-3xl border border-slate-200/80 bg-white/60 p-4 shadow-sm shadow-slate-900/5 backdrop-blur-md sm:gap-5 sm:p-5 dark:border-slate-700/50 dark:bg-slate-800/40 dark:shadow-black/10">
    <div class="flex items-center gap-2">
      <div class="flex-1">
        <SearchBar />
      </div>
      <button
        id="toggle-filters"
        aria-label="显示筛选"
        aria-expanded="false"
        class="flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-2xl border border-slate-200/90 bg-white/60 text-slate-600 transition-all duration-300 hover:text-slate-900 hover:border-slate-300 sm:hidden dark:border-slate-700/60 dark:bg-slate-800/40 dark:text-slate-400 dark:hover:text-slate-200 dark:hover:border-slate-600"
      >
        <svg id="filter-icon-closed" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" />
        </svg>
        <svg id="filter-icon-open" class="hidden h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div id="filters-panel" class="hidden overflow-hidden transition-all duration-300 sm:block">
      <CategoryFilter categories={categories} sources={sources} types={types} />
    </div>
  </div>

  <script is:inline>
    document.addEventListener('astro:page-load', function () {
      var btn = document.getElementById('toggle-filters');
      var panel = document.getElementById('filters-panel');
      var iconClosed = document.getElementById('filter-icon-closed');
      var iconOpen = document.getElementById('filter-icon-open');
      if (btn && panel) {
        btn.onclick = function () {
          var isOpen = !panel.classList.contains('hidden');
          if (isOpen) {
            panel.classList.add('hidden');
            if (iconClosed) iconClosed.classList.remove('hidden');
            if (iconOpen) iconOpen.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
          } else {
            panel.classList.remove('hidden');
            if (iconClosed) iconClosed.classList.add('hidden');
            if (iconOpen) iconOpen.classList.remove('hidden');
            btn.setAttribute('aria-expanded', 'true');
          }
        };
      }
    });
  </script>

  <!-- 结果计数（筛选模式） -->
  <div id="results-count" class="hidden text-xs text-slate-500 dark:text-slate-400"></div>

  <!-- 浏览模式：静态文章 -->
  <div id="browse-mode">
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {articles.map((article, i) => (
        <ArticleCard article={article} eager={i === 0} />
      ))}
    </div>

    {articles.length === 0 && (
      <div class="py-20 text-center text-slate-500 dark:text-slate-400">
        <svg class="mx-auto mb-4 h-12 w-12 text-slate-300 dark:text-slate-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z" />
        </svg>
        <p class="text-lg font-medium text-slate-700 dark:text-slate-300">暂无文章</p>
        <p class="mt-1 text-sm">首次 RSS 同步完成后，文章会显示在这里。</p>
      </div>
    )}

    {totalPages > 1 && (
      <nav aria-label="分页" class="mt-10 flex items-center justify-center gap-1.5">
        {currentPage > 1 && (
          <a href={pageUrl(currentPage - 1)} class={pageLinkClass} aria-label="上一页">←</a>
        )}
        {pages.map((p) =>
          p === '...' ? (
            <span class="px-2 py-2 text-sm text-slate-400 dark:text-slate-600">…</span>
          ) : p === currentPage ? (
            <span
              class="rounded-xl border border-emerald-600/45 bg-emerald-600/10 px-3 py-2 text-sm font-semibold text-emerald-800 shadow-sm shadow-emerald-600/10 dark:border-emerald-400/45 dark:bg-emerald-400/15 dark:text-emerald-300 dark:shadow-emerald-400/10"
              aria-current="page">{p}</span>
          ) : (
            <a href={pageUrl(p as number)} class={pageLinkClass}>{p}</a>
          )
        )}
        {currentPage < totalPages && (
          <a href={pageUrl(currentPage + 1)} class={pageLinkClass} aria-label="下一页">→</a>
        )}
      </nav>
    )}
  </div>

  <!-- 搜索 / 筛选模式 -->
  <div id="search-mode" class="hidden">
    <div id="search-results" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>
    <nav id="search-pagination" aria-label="分页" class="mt-10 flex items-center justify-center gap-1.5"></nav>
  </div>

  <!-- 无结果 -->
  <div id="no-results" class="hidden py-20 text-center text-slate-500 dark:text-slate-400">
    <p class="text-lg font-medium text-slate-700 dark:text-slate-300">没有找到结果</p>
    <p class="mt-1 text-sm">请尝试其他关键词。</p>
  </div>
</div>

<script is:inline define:vars={{ searchIndexUrl }}>
  window.__searchIndexUrl = searchIndexUrl;
</script>

<script>
  import Fuse from 'fuse.js';
  import { withBase } from '../utils/url';
  // 只从 ui.ts 取配色/文案：它不含 import.meta.glob，
  // 不会把整年 JSON 数据打进客户端 bundle。
  import {
    getCategoryColor,
    getCategoryLabel,
    getPlaceholderClass,
    getTypeColor,
    getTypeLabel,
    getFreshnessBadge,
    formatDate,
    FILTER_ACTIVE_CLASSES,
    FILTER_INACTIVE_CLASSES,
  } from '../utils/ui';

  const PAGE_SIZE = 15;

  interface SearchArticle {
    id: string;
    title: string;
    description: string;
    source: string;
    sourceUrl: string;
    categories: string[];
    pubDate: string;
    image: string;
    link: string;
    type: string;
    audioUrl?: string;
    duration?: string;
  }

  let searchIndex: SearchArticle[] | null = null;
  let fuse: Fuse<SearchArticle> | null = null;

  async function loadSearchIndex(): Promise<SearchArticle[]> {
    if (searchIndex) return searchIndex;
    const res = await fetch((window as any).__searchIndexUrl || withBase('/search-index.json'));
    searchIndex = await res.json();
    return searchIndex!;
  }

  function escapeHtml(str: string): string {
    return String(str ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // 结构与 ArticleCard.astro 保持一致：改卡片样式时这里要同步改。
  function renderCard(a: SearchArticle): string {
    const badge = getFreshnessBadge(a.pubDate);
    const placeholder = getPlaceholderClass(a.id || a.link);
    const href = withBase(`/article/${a.id}`);

    const catsHtml = a.categories
      .map(
        (c) =>
          `<span class="rounded-full border px-2.5 py-0.5 text-[11px] font-medium ${getCategoryColor(c)}">${escapeHtml(getCategoryLabel(c))}</span>`
      )
      .join('');

    const placeholderInner = `<span class="relative z-10 line-clamp-3 text-center text-sm font-medium leading-relaxed text-slate-800/70 dark:text-slate-100/60">${escapeHtml(a.title)}</span>`;

    const imageHtml = a.image
      ? `<img src="${escapeHtml(a.image)}" alt="${escapeHtml(a.title)}" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
         <div class="ph-surface ${placeholder} relative hidden h-full w-full items-center justify-center p-5">${placeholderInner}</div>`
      : `<div class="ph-surface ${placeholder} relative flex h-full w-full items-center justify-center p-5">${placeholderInner}</div>`;

    const badgeHtml = badge
      ? `<span class="absolute left-3 top-3 rounded-full px-2.5 py-0.5 text-[11px] font-semibold ${badge.class}">${badge.label}</span>`
      : '';

    const typeBadgeHtml =
      a.type === 'podcast' || a.type === 'youtube'
        ? `<span class="absolute right-3 top-3 rounded-full border px-2.5 py-0.5 text-[11px] font-semibold backdrop-blur-md ${getTypeColor(a.type as 'podcast' | 'youtube')}">${getTypeLabel(a.type as 'podcast' | 'youtube')}</span>`
        : '';

    return `<article class="card group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200/80 bg-white/60 shadow-sm shadow-slate-900/5 backdrop-blur-md transition-all duration-300 hover:-translate-y-1.5 hover:border-sky-400/60 hover:shadow-lg hover:shadow-sky-500/20 dark:border-slate-700/50 dark:bg-slate-800/50 dark:shadow-black/20 dark:hover:border-sky-400/40 dark:hover:shadow-sky-500/25 fade-in-up">
      <a href="${href}" class="relative block aspect-[16/9] overflow-hidden bg-slate-100 dark:bg-slate-900/40">
        ${imageHtml}
        ${badgeHtml}
        ${typeBadgeHtml}
      </a>
      <div class="flex flex-1 flex-col gap-3 p-5">
        <div class="flex flex-wrap gap-1.5">${catsHtml}</div>
        <h3 class="text-lg font-bold leading-snug tracking-tight text-slate-900 sm:text-xl dark:text-slate-100">
          <a href="${href}" class="line-clamp-2 transition-colors duration-200 hover:text-sky-700 dark:hover:text-sky-300">${escapeHtml(a.title)}</a>
        </h3>
        <p class="line-clamp-3 text-sm leading-relaxed text-slate-500 dark:text-slate-400">${escapeHtml(a.description)}</p>
        <div class="flex items-center justify-between pt-1 text-xs text-slate-400 dark:text-slate-500">
          <time datetime="${escapeHtml(a.pubDate)}">${formatDate(a.pubDate)}</time>
        </div>
        <a href="${escapeHtml(a.link)}" target="_blank" rel="noopener noreferrer"
           class="group/cta mt-auto flex items-center justify-between gap-3 rounded-xl border border-slate-200/90 bg-slate-50/70 px-3.5 py-2.5 transition-all duration-300 hover:border-emerald-500/40 hover:bg-emerald-500/10 dark:border-slate-700/60 dark:bg-slate-700/25 dark:hover:border-emerald-400/40 dark:hover:bg-emerald-400/10">
          <div class="flex min-w-0 items-center gap-2">
            <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-emerald-600/10 text-emerald-700 dark:bg-emerald-400/15 dark:text-emerald-300">
              <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/></svg>
            </div>
            <span class="truncate text-xs font-medium text-slate-600 dark:text-slate-300">${escapeHtml(a.source)}</span>
          </div>
          <div class="flex shrink-0 items-center gap-1 text-xs font-medium text-emerald-700 dark:text-emerald-300">
            <span class="hidden sm:inline">阅读</span>
            <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover/cta:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </div>
        </a>
      </div>
    </article>`;
  }

  const PAGER_BASE =
    'cursor-pointer rounded-xl border border-slate-200/90 px-3 py-2 text-sm text-slate-600 transition-all duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:text-slate-900 dark:border-slate-700/60 dark:text-slate-400 dark:hover:border-slate-600 dark:hover:text-slate-200';
  const PAGER_CURRENT =
    'rounded-xl border border-emerald-600/45 bg-emerald-600/10 px-3 py-2 text-sm font-semibold text-emerald-800 shadow-sm shadow-emerald-600/10 dark:border-emerald-400/45 dark:bg-emerald-400/15 dark:text-emerald-300 dark:shadow-emerald-400/10';

  document.addEventListener('astro:page-load', () => {
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const browseMode = document.getElementById('browse-mode');
    const searchModeEl = document.getElementById('search-mode');
    const searchResults = document.getElementById('search-results');
    const searchPagination = document.getElementById('search-pagination');
    const resultsCount = document.getElementById('results-count');
    const noResults = document.getElementById('no-results');
    const filterBtns = document.querySelectorAll('.filter-btn');
    const sourceSelect = document.getElementById('source-select') as HTMLSelectElement | null;
    const typeSelect = document.getElementById('type-select') as HTMLSelectElement | null;

    let activeCategory = 'all';
    let activeSource = 'all';
    let activeType = 'all';
    let searchQuery = '';
    let currentSearchPage = 1;

    function isFilterActive(): boolean {
      return searchQuery.length >= 2 || activeCategory !== 'all' || activeSource !== 'all' || activeType !== 'all';
    }

    async function updateView() {
      if (!isFilterActive()) {
        browseMode?.classList.remove('hidden');
        searchModeEl?.classList.add('hidden');
        noResults?.classList.add('hidden');
        resultsCount?.classList.add('hidden');
        return;
      }

      const index = await loadSearchIndex();
      if (!fuse) {
        fuse = new Fuse(index, {
          keys: ['title', 'description', 'source', 'categories'],
          threshold: 0.3,
          ignoreLocation: true,
        });
      }

      let results: SearchArticle[] = [...index];
      if (searchQuery.length >= 2) {
        results = fuse.search(searchQuery).map((r) => r.item);
      }
      if (activeCategory !== 'all') {
        results = results.filter((a) => a.categories.includes(activeCategory));
      }
      if (activeSource !== 'all') {
        results = results.filter((a) => a.source === activeSource);
      }
      if (activeType !== 'all') {
        results = results.filter((a) => (a.type || 'blog') === activeType);
      }

      browseMode?.classList.add('hidden');

      if (results.length === 0) {
        searchModeEl?.classList.add('hidden');
        noResults?.classList.remove('hidden');
        resultsCount?.classList.add('hidden');
        return;
      }

      noResults?.classList.add('hidden');
      searchModeEl?.classList.remove('hidden');
      resultsCount?.classList.remove('hidden');

      const totalPages = Math.ceil(results.length / PAGE_SIZE);
      if (currentSearchPage > totalPages) currentSearchPage = totalPages;
      const start = (currentSearchPage - 1) * PAGE_SIZE;
      const pageResults = results.slice(start, start + PAGE_SIZE);

      if (resultsCount) {
        resultsCount.textContent = `${results.length} 篇文章`;
      }

      if (searchResults) {
        searchResults.innerHTML = pageResults.map((a) => renderCard(a)).join('');
      }

      renderSearchPagination(totalPages);
    }

    function renderSearchPagination(totalPages: number) {
      if (!searchPagination) return;
      if (totalPages <= 1) {
        searchPagination.innerHTML = '';
        return;
      }

      const pgs: (number | string)[] = [];
      for (let i = 1; i <= totalPages; i++) {
        if (i === 1 || i === totalPages || (i >= currentSearchPage - 1 && i <= currentSearchPage + 1)) {
          pgs.push(i);
        } else if (pgs[pgs.length - 1] !== '...') {
          pgs.push('...');
        }
      }

      let html = '';
      if (currentSearchPage > 1) {
        html += `<button data-page="${currentSearchPage - 1}" class="search-page-btn ${PAGER_BASE}" aria-label="上一页">←</button>`;
      }
      for (const p of pgs) {
        if (p === '...') {
          html += `<span class="px-2 py-2 text-sm text-slate-400 dark:text-slate-600">…</span>`;
        } else if (p === currentSearchPage) {
          html += `<span class="${PAGER_CURRENT}" aria-current="page">${p}</span>`;
        } else {
          html += `<button data-page="${p}" class="search-page-btn ${PAGER_BASE}">${p}</button>`;
        }
      }
      if (currentSearchPage < totalPages) {
        html += `<button data-page="${currentSearchPage + 1}" class="search-page-btn ${PAGER_BASE}" aria-label="下一页">→</button>`;
      }

      searchPagination.innerHTML = html;
      searchPagination.querySelectorAll('.search-page-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          currentSearchPage = parseInt((btn as HTMLElement).dataset.page || '1');
          updateView();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });
    }

    // 搜索输入（防抖）
    let debounceTimer: ReturnType<typeof setTimeout>;
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      currentSearchPage = 1;
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => updateView(), 200);
    });

    // 快捷键
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput?.focus();
      }
    });

    // 分类筛选：选中态 = 柔和底色 + 明显描边，不用纯色填充
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = (btn as HTMLElement).dataset.category || 'all';
        filterBtns.forEach((b) => {
          b.classList.remove(...FILTER_ACTIVE_CLASSES);
          b.classList.add(...FILTER_INACTIVE_CLASSES);
        });
        btn.classList.add(...FILTER_ACTIVE_CLASSES);
        btn.classList.remove(...FILTER_INACTIVE_CLASSES);
        currentSearchPage = 1;
        updateView();
      });
    });

    // 来源筛选
    sourceSelect?.addEventListener('change', () => {
      activeSource = sourceSelect.value;
      currentSearchPage = 1;
      updateView();
    });

    // 类型筛选
    typeSelect?.addEventListener('change', () => {
      activeType = typeSelect.value;
      currentSearchPage = 1;
      updateView();
    });

    // 未读标记（localStorage）—— 只作用于静态卡片
    const LAST_VISIT_KEY = 'flux-last-visit';
    const lastVisit = localStorage.getItem(LAST_VISIT_KEY);
    if (lastVisit && browseMode) {
      const cards = Array.from(browseMode.querySelectorAll('article'));
      cards.forEach((card) => {
        const id = card.getAttribute('data-article-id');
        if (id && !localStorage.getItem(`flux-read-${id}`)) {
          const titleEl = card.querySelector('h3');
          if (titleEl && !titleEl.querySelector('.unread-dot')) {
            const dot = document.createElement('span');
            dot.className = 'unread-dot inline-block ml-1.5 h-2 w-2 flex-shrink-0 rounded-full bg-emerald-500';
            dot.title = '未读';
            titleEl.classList.add('flex', 'items-start');
            titleEl.appendChild(dot);
          }
        }
      });
    }
    localStorage.setItem(LAST_VISIT_KEY, new Date().toISOString());
  });
</script>
