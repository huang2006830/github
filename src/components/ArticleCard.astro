---
import type { Article } from '../types/index';
import {
  getFreshnessBadge,
  formatDate,
  getPlaceholderClass,
  getCategoryColor,
  getCategoryLabel,
  getTypeLabel,
  getTypeColor,
  getCategorySlug,
} from '../utils/articles';
import { withBase } from '../utils/url';

interface Props {
  article: Article;
  eager?: boolean;
}

const { article, eager = false } = Astro.props;
const badge = getFreshnessBadge(article.pubDate);
const placeholder = getPlaceholderClass(article.id || article.link);
const articleHref = withBase(`/article/${article.id}`);
---

<article
  class="card group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200/80 bg-white/60 shadow-sm shadow-slate-900/5 backdrop-blur-md transition-all duration-300 hover:-translate-y-1.5 hover:border-sky-400/60 hover:shadow-lg hover:shadow-sky-500/20 dark:border-slate-700/50 dark:bg-slate-800/50 dark:shadow-black/20 dark:hover:border-sky-400/40 dark:hover:shadow-sky-500/25 fade-in-up"
  data-article-id={article.id}
  data-source={article.source}
  data-categories={article.categories.join(',')}
  data-title={article.title}
  data-description={article.description}
>
  <!-- 封面 -->
  <a href={articleHref} class="relative block aspect-[16/9] overflow-hidden bg-slate-100 dark:bg-slate-900/40">
    {article.image ? (
      <>
        <img
          src={article.image}
          alt={article.title}
          loading={eager ? 'eager' : 'lazy'}
          decoding={eager ? 'sync' : 'async'}
          fetchpriority={eager ? 'high' : undefined}
          class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
          onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
        />
        <div class={`ph-surface ${placeholder} relative hidden h-full w-full items-center justify-center p-5`}>
          <span class="relative z-10 line-clamp-3 text-center text-sm font-medium leading-relaxed text-slate-800/70 dark:text-slate-100/60">
            {article.title}
          </span>
        </div>
      </>
    ) : (
      <div class={`ph-surface ${placeholder} relative flex h-full w-full items-center justify-center p-5`}>
        <span class="relative z-10 line-clamp-3 text-center text-sm font-medium leading-relaxed text-slate-800/70 dark:text-slate-100/60">
          {article.title}
        </span>
      </div>
    )}

    {badge && (
      <span class={`absolute left-3 top-3 rounded-full px-2.5 py-0.5 text-[11px] font-semibold ${badge.class}`}>
        {badge.label}
      </span>
    )}
    {(article.type === 'podcast' || article.type === 'youtube') && (
      <span
        class={`absolute right-3 top-3 rounded-full border px-2.5 py-0.5 text-[11px] font-semibold backdrop-blur-md ${getTypeColor(article.type)}`}
      >
        {getTypeLabel(article.type)}
      </span>
    )}
  </a>

  <!-- 内容 -->
  <div class="flex flex-1 flex-col gap-3 p-5">
    <!-- 分类 -->
    <div class="flex flex-wrap gap-1.5">
      {article.categories.map((cat) => (
        <a
          href={withBase(`/categorie/${getCategorySlug(cat)}`)}
          class={`rounded-full border px-2.5 py-0.5 text-[11px] font-medium transition-opacity duration-200 hover:opacity-70 ${getCategoryColor(cat)}`}
        >
          {getCategoryLabel(cat)}
        </a>
      ))}
    </div>

    <!-- 标题 -->
    <h3 class="text-lg font-bold leading-snug tracking-tight text-slate-900 sm:text-xl dark:text-slate-100">
      <a
        href={articleHref}
        class="line-clamp-2 transition-colors duration-200 hover:text-sky-700 dark:hover:text-sky-300"
      >
        {article.title}
      </a>
    </h3>

    <!-- 摘要 -->
    <p class="line-clamp-3 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
      {article.description}
    </p>

    <!-- 元信息 -->
    <div class="flex items-center justify-between pt-1 text-xs text-slate-400 dark:text-slate-500">
      <time datetime={article.pubDate}>{formatDate(article.pubDate)}</time>
    </div>

    <!-- 来源入口 -->
    <a
      href={article.link}
      target="_blank"
      rel="noopener noreferrer"
      class="group/cta mt-auto flex items-center justify-between gap-3 rounded-xl border border-slate-200/90 bg-slate-50/70 px-3.5 py-2.5 transition-all duration-300 hover:border-emerald-500/40 hover:bg-emerald-500/10 dark:border-slate-700/60 dark:bg-slate-700/25 dark:hover:border-emerald-400/40 dark:hover:bg-emerald-400/10"
    >
      <div class="flex min-w-0 items-center gap-2">
        <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-emerald-600/10 text-emerald-700 dark:bg-emerald-400/15 dark:text-emerald-300">
          <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/></svg>
        </div>
        <span class="truncate text-xs font-medium text-slate-600 dark:text-slate-300">{article.source}</span>
      </div>
      <div class="flex shrink-0 items-center gap-1 text-xs font-medium text-emerald-700 dark:text-emerald-300">
        <span class="hidden sm:inline">阅读</span>
        <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover/cta:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </div>
    </a>
  </div>
</article>
