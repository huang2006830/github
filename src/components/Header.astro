---
import { loadAllArticles, loadWorldArticles, getAllSources } from '../utils/articles';
import { withBase } from '../utils/url';
import { SITE_NAME } from '../config/site';

let articleCount = 0;
let sourceCount = 0;

try {
  const articles = [...loadAllArticles(), ...loadWorldArticles()];
  articleCount = articles.length;
  sourceCount = getAllSources(articles).length;
} catch {
  // 暂无数据
}

const buildDate = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  month: 'numeric',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
}).format(new Date());

const navItems = [
  { label: '文章', href: withBase('/') },
  { label: '学习路线', href: withBase('/learning-path') },
  { label: '学习资料', href: withBase('/resources') },
  { label: '极客速查', href: withBase('/cheatsheet') },
  { label: '来源', href: withBase('/sources') },
  { label: '分类', href: withBase('/categories') },
  { label: '统计', href: withBase('/stats') },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-[var(--color-glass)] backdrop-blur-xl dark:border-slate-700/50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-4">
      <!-- Logo -->
      <a href={withBase('/')} class="group flex shrink-0 items-center gap-3">
        <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 shadow-md shadow-emerald-500/25 transition-shadow duration-300 group-hover:shadow-lg group-hover:shadow-emerald-500/40">
          <svg class="h-4 w-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/></svg>
        </div>
        <span class="text-base font-bold tracking-tight text-slate-900 sm:text-lg dark:text-slate-100">{SITE_NAME}</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden items-center gap-5 md:flex">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="whitespace-nowrap text-sm text-slate-600 transition-colors duration-200 hover:text-emerald-700 dark:text-slate-400 dark:hover:text-emerald-300"
          >
            {item.label}
          </a>
        ))}
        <!-- Stats -->
        <div class="hidden items-center gap-2.5 border-l border-slate-200 pl-5 text-xs text-slate-500 xl:flex dark:border-slate-700/60 dark:text-slate-400">
          <span class="flex items-center gap-1.5">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-600 animate-pulse dark:bg-emerald-400"></span>
            {articleCount} 篇文章
          </span>
          <span class="text-slate-300 dark:text-slate-600">·</span>
          <span>{sourceCount} 个来源</span>
          <span class="text-slate-300 dark:text-slate-600">·</span>
          <span title="最后更新时间">更新 {buildDate}</span>
        </div>
      </nav>

      <!-- 主题切换 + 移动端菜单 -->
      <div class="flex items-center gap-2">
        <button
          id="theme-toggle"
          type="button"
          aria-label="切换亮色 / 暗色主题"
          title="切换亮色 / 暗色主题"
          aria-pressed="false"
          class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-xl border border-slate-200/90 bg-white/60 text-slate-600 transition-all duration-300 hover:border-emerald-500/40 hover:text-emerald-700 hover:shadow-md hover:shadow-emerald-500/10 dark:border-slate-700/70 dark:bg-slate-800/50 dark:text-slate-300 dark:hover:border-emerald-400/40 dark:hover:text-emerald-300 dark:hover:shadow-emerald-500/10"
        >
          <!-- 暗色时显示太阳（点了回亮色） -->
          <svg class="hidden h-[18px] w-[18px] dark:block" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
          <!-- 亮色时显示月亮（点了去暗色） -->
          <svg class="h-[18px] w-[18px] dark:hidden" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
          </svg>
        </button>

        <button
          id="burger-btn"
          class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-xl text-slate-600 transition-colors hover:text-emerald-700 md:hidden dark:text-slate-300 dark:hover:text-emerald-300"
          aria-label="菜单"
          aria-expanded="false"
        >
          <svg id="burger-icon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
          </svg>
          <svg id="close-icon" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-slate-200/70 bg-[var(--color-glass-strong)] backdrop-blur-xl md:hidden dark:border-slate-700/50">
    <nav class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-4">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="rounded-xl px-3 py-2.5 text-sm text-slate-600 transition-colors hover:bg-slate-200/60 hover:text-emerald-700 dark:text-slate-400 dark:hover:bg-slate-800/60 dark:hover:text-emerald-300"
        >
          {item.label}
        </a>
      ))}
      <div class="mt-2 flex items-center gap-3 border-t border-slate-200/70 px-3 pt-3 text-xs text-slate-500 dark:border-slate-700/50 dark:text-slate-400">
        <span class="flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-600 animate-pulse dark:bg-emerald-400"></span>
          {articleCount} 篇文章
        </span>
        <span class="text-slate-300 dark:text-slate-600">·</span>
        <span>{sourceCount} 个来源</span>
      </div>
    </nav>
  </div>
</header>

<script>
  function applyTheme(theme: 'light' | 'dark') {
    const root = document.documentElement;
    root.classList.toggle('dark', theme === 'dark');
    root.dataset.theme = theme;
    try {
      localStorage.setItem('flux-theme', theme);
    } catch {
      /* 忽略隐私模式下的写入失败 */
    }
    document.getElementById('theme-toggle')?.setAttribute('aria-pressed', String(theme === 'dark'));
  }

  function syncToggleState() {
    const isDark = document.documentElement.classList.contains('dark');
    document.getElementById('theme-toggle')?.setAttribute('aria-pressed', String(isDark));
  }

  document.addEventListener('astro:page-load', () => {
    /* ── 主题切换 ── */
    const themeToggle = document.getElementById('theme-toggle');
    if (themeToggle && !themeToggle.dataset.bound) {
      themeToggle.dataset.bound = '1';
      themeToggle.addEventListener('click', () => {
        const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
        applyTheme(next);
      });
    }
    syncToggleState();

    /* ── 移动端菜单 ── */
    const btn = document.getElementById('burger-btn');
    const menu = document.getElementById('mobile-menu');
    const burgerIcon = document.getElementById('burger-icon');
    const closeIcon = document.getElementById('close-icon');
    if (!btn || !menu || !burgerIcon || !closeIcon) return;

    btn.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden');
      burgerIcon.classList.toggle('hidden', !open);
      closeIcon.classList.toggle('hidden', open);
      btn.setAttribute('aria-expanded', String(!open));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        burgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  });
</script>
