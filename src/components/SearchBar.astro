---

<div class="search-wrapper group relative">
  <div class="pointer-events-none absolute inset-0 rounded-2xl bg-gradient-to-r from-emerald-500/20 via-sky-500/20 to-emerald-500/20 opacity-0 blur-xl transition-opacity duration-500 group-focus-within:opacity-100"></div>
  <div class="relative flex items-center overflow-hidden rounded-2xl border border-slate-200/90 bg-white/70 backdrop-blur-md transition-all duration-300 group-focus-within:border-emerald-500/50 group-focus-within:shadow-md group-focus-within:shadow-emerald-500/10 dark:border-slate-700/60 dark:bg-slate-800/40 dark:group-focus-within:border-emerald-400/50 dark:group-focus-within:shadow-emerald-400/10">
    <div class="pointer-events-none flex items-center pl-4 text-slate-400 transition-colors duration-300 group-focus-within:text-emerald-700 dark:text-slate-500 dark:group-focus-within:text-emerald-300">
      <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
    <input
      id="search-input"
      type="search"
      placeholder="搜索文章、来源或主题…"
      aria-label="搜索文章"
      class="w-full bg-transparent px-3 py-3.5 text-sm text-slate-900 placeholder-slate-400 transition-colors focus:outline-none focus:placeholder-slate-500 dark:text-slate-100 dark:placeholder-slate-500 dark:focus:placeholder-slate-400"
    />
    <div class="hidden items-center gap-1.5 pr-3 sm:flex">
      <kbd class="rounded-md border border-slate-200 bg-slate-100/80 px-2 py-1 font-mono text-[10px] leading-none tracking-wider text-slate-500 dark:border-slate-700/60 dark:bg-slate-800/70 dark:text-slate-400">
        /
      </kbd>
    </div>
  </div>
</div>
