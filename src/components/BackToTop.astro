<button
  id="back-to-top"
  aria-label="返回顶部"
  class="fixed bottom-6 right-6 z-50 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-slate-200/90 bg-white/70 text-slate-500 shadow-lg shadow-slate-900/5 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-emerald-500/50 hover:text-emerald-700 hover:shadow-emerald-500/15 pointer-events-none translate-y-4 opacity-0 dark:border-slate-700/60 dark:bg-slate-800/60 dark:text-slate-400 dark:shadow-black/20 dark:hover:border-emerald-400/50 dark:hover:text-emerald-300"
>
  <svg class="mx-auto h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
  </svg>
</button>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('back-to-top');
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = '1';

    const toggle = () => {
      const show = window.scrollY > 400;
      btn.classList.toggle('opacity-0', !show);
      btn.classList.toggle('translate-y-4', !show);
      btn.classList.toggle('pointer-events-none', !show);
      btn.classList.toggle('opacity-100', show);
      btn.classList.toggle('translate-y-0', show);
      btn.classList.toggle('pointer-events-auto', show);
    };

    toggle();
    window.addEventListener('scroll', toggle, { passive: true });
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
</script>
